// Generated by CMake from .vscode/launch.json.in using ORBITER_DIR from local.cmake. Edit the template, not this file.
{
  "version": "0.2.0",
  "configurations": [
    {
      // Launch Modules/Server/Orbiter.exe, not orbiter_ng.exe: orbiter_ng.exe only spawns the
      // server executable as a child process, which the debugger does not follow.
      "name": "Debug SR71R in Orbiter",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "@ORBITER_DIR@/Modules/Server/Orbiter.exe",
      "args": [],
      "cwd": "@ORBITER_DIR@",
      "console": "internalConsole",
      "preLaunchTask": "CMake: build"
    },
    {
      "name": "Attach to Orbiter",
      "type": "cppvsdbg",
      "request": "attach",
      "processId": "${command:pickProcess}"
    }
  ]
}
