{
  "version": 4,
  "configurations": [
    {
      "name": "Orbiter",
      "configurationProvider": "ms-vscode.cmake-tools",
      "compilerPath": "@CMAKE_CXX_COMPILER@",
      "intelliSenseMode": "windows-msvc-x86",
      "cppStandard": "c++20",
      "includePath": [
        "${workspaceFolder}/SR71R",
        "${workspaceFolder}",
        "@ORBITER_DIR@/Orbitersdk/include"
      ],
      "defines": ["WIN32", "_WINDOWS", "_USRDLL", "SR71R_EXPORTS", "UNICODE", "_UNICODE"],
      "forcedInclude": ["${workspaceFolder}/SR71R/StdAfx.h"]
    }
  ]
}
